# ==================================================================
# AFK-Manager - Einstellungen
# Kopieren:  cp .env.example .env   und dann .env ausfüllen.
# Die .env enthält Zugangsdaten und kommt NIE ins Repository.
# Zeilen mit # davor sind abgeschaltet bzw. nur Erklärung.
# ==================================================================

# ---------- Webseite ----------
# Port des Dashboards
PORT=3000
# Passwort für den ersten Start: daraus wird der Owner-Account angelegt.
# Danach Passwörter im Dashboard unter Verwaltung ändern. Ohne Passwort ist das
# Dashboard für JEDEN offen - nie ohne Passwort ins Internet stellen!
DASHBOARD_PASSWORD=
# Name dieses ersten Owner-Benutzers (Standard: admin). Gilt nur beim allerersten Start.
DASHBOARD_OWNER=
# Name in den Seitentiteln (Standard: MC_SERVER_HOST)
# DASHBOARD_TITLE=Mein Server

# ---------- Minecraft-Server ----------
# Adresse des Servers, auf dem die Accounts AFK sein sollen
MC_SERVER_HOST=clashsmp.de
MC_SERVER_PORT=25565
# Sichtweite der Java-Bots in Chunks (klein = wenig Last)
MC_VIEW_DISTANCE=2

# ---------- Bedrock-Accounts (Namen mit Punkt davor, z.B. .MeinGamertag) ----------
MC_BEDROCK_PORT=19132
MC_BEDROCK_VIEW_DISTANCE=2
# auto (NetherNet, wenn der Server es anbietet, sonst RakNet) | nethernet | raknet
MC_BEDROCK_TRANSPORT=auto
# leer = nur IPv4 | 1 = IPv4 und IPv6 | only = nur IPv6
# (clashsmp.de antwortet seit 31.10.2026 über IPv4 nicht auf NetherNet -> only)
MC_BEDROCK_NETHERNET_IPV6=
# werift empfohlen: jeder Bedrock-Account läuft dann in einem eigenen Thread
MC_BEDROCK_NETHERNET_WEBRTC=werift
# Feste Bedrock-Version, leer = neueste, die bedrock-protocol kennt
# MC_BEDROCK_VERSION=1.26.60
# Schutz gegen Dauer-Neuverbindungen: nach so vielen Fehlschlägen in Folge Pause (Minuten)
# MC_BEDROCK_PAUSE_AFTER_FAILS=5
# MC_BEDROCK_PAUSE_MIN=15
# Abschalten einzelner Entlastungen (nur zur Fehlersuche):
# MC_BEDROCK_THREADS=0
# MC_BEDROCK_PACKET_FILTER=0
# MC_BEDROCK_FAST_INFLATE=0
# Zusätzliche Bedrock-Pakete lesen (Namen aus minecraft-data, durch Komma getrennt)
# MC_BEDROCK_KEEP_PACKETS=text

# ---------- Discord ----------
# Webhooks (Rückfall, wenn kein Bot eingerichtet ist)
DISCORD_WEBHOOK_URL=
DISCORD_CHAT_WEBHOOK_URL=
# Bot: Befehle (!start, !stop, !add ...) und Knöpfe
DISCORD_BOT_TOKEN=
# Kanal, in dem die !-Befehle gelten
DISCORD_CHANNEL_ID=
# Nur Mitglieder mit diesen Rollen dürfen Befehle benutzen (IDs, durch Komma getrennt).
# LEER = JEDER im Kanal darf! Unbedingt setzen.
DISCORD_ALLOWED_ROLE_IDS=
# Kanäle fest vorgeben (sonst aus den Webhook-Adressen ermittelt)
# DISCORD_NOTIFY_CHANNEL_ID=
# DISCORD_CHAT_CHANNEL_ID=
# Präfix für Chat über Discord: "!mc Accountname Nachricht"
# DISCORD_COMMAND_PREFIX=!mc

# ---------- Sonstiges ----------
# Protokoll-Meldungen zusätzlich in Discord (Standard: aus, nur im Dashboard)
# AUDIT_DISCORD=1
# Puffer nach Ablauf eines Microsoft-Login-Codes (Millisekunden)
# MSA_CODE_GRACE_MS=30000
